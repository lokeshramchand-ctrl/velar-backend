# Velar Backend — local development environment
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Every variable here
# mirrors a field on `Settings` in core/config.py — the app fails fast at
# startup if a required (no default) variable is missing, so keep the two
# in sync if you add a new setting.
#
# The defaults below assume you're running the FULL stack with:
#   docker compose -f docker-compose_local.yaml up --build
# which starts MongoDB, Milvus (etcd + minio + milvus), and the backend
# itself as containers on the same Docker network — so services reach each
# other by container name (`mongodb`, `milvus`), not `localhost`.
#
# Running the backend directly on the host instead (`uvicorn app:app --reload`,
# with only the infra containers up)? Switch MONGODB_URI/MILVUS_URI to the
# `localhost` variants shown commented out below — compose still publishes
# those ports to the host.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017
# MONGODB_URI=mongodb://localhost:27017          # use this if running the app on the host, not in Docker
MONGODB_DB_NAME=velar

# Local dev's mongo:6.0 container has no TLS listener configured (see
# docker-compose_local.yaml), so TLS must be disabled here. Never set these
# to false against a real/production MongoDB — see docs/DATABASE_SECURITY.md.
MONGODB_REQUIRE_TLS=false
MONGODB_VALIDATE_TLS_CERTIFICATE=false

MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Milvus (vector store)
# ---------------------------------------------------------------------------
MILVUS_URI=http://milvus:19530
# MILVUS_URI=http://localhost:19530               # use this if running the app on the host, not in Docker

# ---------------------------------------------------------------------------
# Ollama (embeddings + generation) — runs natively on the host, not in
# docker-compose_local.yaml (GPU passthrough into a container isn't worth it
# for local dev). Install Ollama (https://ollama.com), pull EMBED_MODEL and
# LLM_MODEL below, then leave it running as a background service.
# ---------------------------------------------------------------------------
# host.docker.internal lets the velar-backend container reach the host's
# Ollama server; works on Linux, macOS, and Windows (docker-compose_local.yaml
# adds the required extra_hosts entry).
OLLAMA_URI=http://host.docker.internal:11434
# OLLAMA_URI=http://localhost:11434                # use this if running the app on the host, not in Docker
# OLLAMA_HOSTS=http://host1:11434,http://host2:11434   # optional comma-separated failover list instead of OLLAMA_URI

# Replace with whatever models you've actually pulled, e.g.:
#   ollama pull nomic-embed-text
#   ollama pull llama3
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3

# ---------------------------------------------------------------------------
# API authentication
# ---------------------------------------------------------------------------
# Authenticates the *calling application* (ships inside client app binaries).
# Any non-empty string works for local dev; generate a real one for anything
# shared or deployed:  openssl rand -hex 32
VELAR_API_KEY=dev-local-api-key-change-me

# Gates the batch/ops endpoints in routers/pipelines.py (behavior profiling,
# embedding sync, decay sweep, clustering, graph rebuild). Left unset by
# default — those endpoints 503 until you set this. Optional for local dev
# unless you're working on those pipelines specifically.
# ADMIN_API_KEY=dev-local-admin-key-change-me

# ---------------------------------------------------------------------------
# JWT user authentication
# ---------------------------------------------------------------------------
# Signs per-user access/refresh tokens (core/jwt_auth.py). Must be at least
# 32 characters — the app refuses to start otherwise. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=dev-local-jwt-secret-please-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Operational settings
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Local dev talks plain HTTP — disable the HTTPS-only enforcement that's on
# by default in production.
ENFORCE_HTTPS=false
# Comma-separated list of allowed CORS origins. Add your local frontend's
# dev-server origin(s) here (e.g. Flutter web run, a local web client).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

MAX_REQUEST_BODY_BYTES=80000000
MAX_STATEMENT_PDF_BYTES=10000000
MAX_APK_UPLOAD_BYTES=80000000
PDF_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Input validation & request constraints
# ---------------------------------------------------------------------------
MAX_STRING_FIELD_LENGTH=500
MAX_USERNAME_LENGTH=128
MAX_PASSWORD_LENGTH=128
MIN_PASSWORD_LENGTH=8
RATE_LIMIT_LOGIN_ATTEMPTS=5/minute
RATE_LIMIT_API_CALLS=100/minute
ENABLE_REQUEST_VALIDATION=true
ENABLE_AUDIT_LOGGING=true

# ---------------------------------------------------------------------------
# Device attestation (Tier 2 security) — off by default, mobile-client only.
# Leave disabled for local API development; only needed if you're testing
# the Play Integrity / App Attest login flow end-to-end.
# ---------------------------------------------------------------------------
DEVICE_ATTESTATION_REQUIRED=false
# GOOGLE_PLAY_INTEGRITY_API_KEY=
# APPLE_TEAM_ID=
# APPLE_BUNDLE_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Request signing & replay protection (Tier 2 security) — off by default.
# Leave disabled unless you're testing HMAC-signed request flows.
# ---------------------------------------------------------------------------
REQUEST_SIGNING_REQUIRED=false
REQUEST_SIGNATURE_MAX_AGE_SECONDS=60
